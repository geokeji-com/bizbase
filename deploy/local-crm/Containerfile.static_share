# 构建上下文为 apps/static_share；先按 Containerfile.yishan_id 构建移山 ID 镜像。
FROM bizbase/local:yishan-id-0.1.0

LABEL org.opencontainers.image.title="BizBase 本地开发预览（含文件分享）"
USER frappe
WORKDIR /home/frappe/frappe-bench
COPY --chown=frappe:frappe . apps/static_share
RUN env/bin/pip install --no-cache-dir --no-deps -e apps/static_share \
    && env/bin/pip check \
    && ln -s /home/frappe/frappe-bench/apps/static_share/static_share/public assets/static_share
