upstream backend-server {
	server ${BACKEND} fail_timeout=0;
}

upstream socketio-server {
	server ${SOCKETIO} fail_timeout=0;
}

# Parse the X-Forwarded-Proto header - if set - defaulting to $scheme.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
	default $scheme;
	https https;
}

# Pass the server-selected hostname, never a client-supplied forwarded authority.
# Keep an explicit port for local previews and sandbox CSP source URLs.
map $http_host $bizbase_request_port {
	default "";
	~:(?<bizbase_port>[0-9]+)$ :$bizbase_port;
}

server {
	listen ${NGINX_LISTEN_PORT} default_server;
	server_name _;
	return 404;
}

server {
	listen ${NGINX_LISTEN_PORT};
	server_name ${FRAPPE_SITE_NAME_HEADER} localhost 127.0.0.1;
	# Optional root-managed snippets contain exact server_name directives only.
	include /etc/nginx/bizbase-share-domains/*.conf;
	absolute_redirect off;
	root /home/frappe/frappe-bench/sites;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	include /etc/nginx/snippets/security_headers.conf;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header ${UPSTREAM_REAL_IP_HEADER};
	real_ip_recursive ${UPSTREAM_REAL_IP_RECURSIVE};

	# Clarity runs only in this isolated feature-count page. Never proxy these URLs to Desk.
	location ^~ /_usage/ {
		if ($args != "") { return 404; }
		access_log off;
		add_header Cache-Control "no-store" always;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header Referrer-Policy "no-referrer" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
		add_header Content-Security-Policy "sandbox allow-scripts; frame-ancestors https://bizbase.geokeji.com" always;
		try_files /assets/yishan_id/clarity-page.html =404;
	}

	# Retired Desk bookmarks only. Keep the suffix and filters; never redirect OIDC callbacks.
	location ~ ^/desk/(?:static_share/|static-share/)?static-share(?:/(?:.*)|$) {
		rewrite ^/desk/(?:static_share/|static-share/)?static-share(.*)$ /desk/file-share$1 redirect;
	}
	location ~ ^/desk/(?:static_share/|static-share/)?static-share-(?:access-log|role|user|version)(?:/|$) {
		rewrite ^/desk/(?:static_share/|static-share/)?static-share-(.*)$ /desk/file-share-$1 redirect;
	}
	location ~ ^/desk/yishan[_-]id[_-]login/yishan-id-binding(?:/|$) {
		rewrite ^/desk/yishan[_-]id[_-]login/(.*)$ /desk/yishan-id/$1 redirect;
	}

	location /assets {
		try_files $uri =404;
	}

	location ~ ^/protected/(.*) {
		internal;
		try_files /${FRAPPE_SITE_NAME_HEADER}/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		# Preserve the browser origin for Frappe v16 same-origin validation.
		proxy_set_header Origin $http_origin;
		proxy_set_header Host $host$bizbase_request_port;
		proxy_set_header X-Forwarded-Host "";
		proxy_set_header Forwarded "";

		proxy_pass http://socketio-server;
	}

	# Only the authenticated share renderer serves expanded bundles.
	location ^~ /private/files/.static_share/ {
		return 404;
	}

	# Preserve bundle paths (including index.html) and enforce share authorization for every asset.
	location ~ ^/(?:file-share(?:/|$)|s/) {
		# Signed asset paths should not appear in the default access log or Referer.
		access_log off;
		add_header X-Frame-Options SAMEORIGIN always;
		add_header X-Content-Type-Options nosniff always;
		add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
		add_header Referrer-Policy no-referrer always;
		proxy_hide_header Referrer-Policy;
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host$bizbase_request_port;
		proxy_set_header X-Forwarded-Host "";
		proxy_set_header Forwarded "";
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;
		proxy_pass http://backend-server;

		# A sandbox subresource may arrive without a Desk session cookie.
		location ~ ^/(?:file-share/s|file-share|s)/[^/]+/c/ {
			proxy_hide_header Referrer-Policy;
			proxy_hide_header Set-Cookie;
			proxy_pass http://backend-server;
		}
	}

	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		location ~ ^/files/.*.(htm|html|svg|xml) {
			include /etc/nginx/snippets/security_headers.conf;
			add_header Content-disposition "attachment";
			try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
		}

		try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host$bizbase_request_port;
		proxy_set_header X-Forwarded-Host "";
		proxy_set_header Forwarded "";
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;

		proxy_pass  http://backend-server;
	}

	# optimizations
	sendfile on;
	keepalive_timeout 15;
	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	# enable gzip compression
	# based on https://mattstauffer.co/blog/enabling-gzip-on-nginx-servers-including-laravel-forge
	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
		# text/html is always compressed by HttpGzipModule
}
