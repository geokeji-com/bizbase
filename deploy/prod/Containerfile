# Official amd64 distribution, including the matching ERPNext environment and assets.
ARG REG=docker.io
FROM ${REG}/frappe/erpnext@sha256:fa1e012a931b12721c4c1407fc0d7876a5ab87d7b3d0757d07e57b2a7d5f5963
USER frappe
WORKDIR /home/frappe/frappe-bench
COPY --chown=frappe:0 apps/geo_operations apps/geo_operations
COPY --chown=frappe:0 apps/yishan_id_login apps/yishan_id_login
COPY --chown=frappe:0 apps/static_share apps/static_share
COPY deploy/local-crm/nginx.conf.template /templates/nginx/frappe.conf.template
COPY deploy/prod/localize_mail_subjects.py deploy/prod/localize_erp_mail.py deploy/prod/localize_erp_templates.py deploy/prod/check_mail_defaults.py /opt/bizbase-mail/
RUN env/bin/python /opt/bizbase-mail/localize_mail_subjects.py \
    && env/bin/python /opt/bizbase-mail/localize_erp_mail.py --image \
    && env/bin/python /opt/bizbase-mail/localize_erp_templates.py
RUN printf '%s\n' frappe erpnext geo_operations yishan_id_login static_share > sites/apps.txt \
    && env/bin/pip install --no-cache-dir --disable-pip-version-check --no-deps -e apps/geo_operations -e apps/yishan_id_login -e apps/static_share \
    && env/bin/pip check \
    && env/bin/python -c 'import erpnext, frappe, geo_operations, yishan_id_login, static_share; assert (frappe.__version__, erpnext.__version__) == ("16.56.0", "16.55.0")' \
    && ln -s /home/frappe/frappe-bench/apps/geo_operations/geo_operations/public assets/geo_operations \
    && ln -s /home/frappe/frappe-bench/apps/yishan_id_login/yishan_id_login/public assets/yishan_id_login \
    && ln -s /home/frappe/frappe-bench/apps/static_share/static_share/public assets/static_share \
    && test -f assets/frappe/dist/js/desk.bundle.*.js \
    && test -f assets/erpnext/dist/js/erpnext.bundle.*.js \
    && test -f assets/static_share/icon.svg
