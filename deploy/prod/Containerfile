# amd64 target of deploy/local-pg/Containerfile built on the pinned production ERPNext digest.
ARG PLATFORM_IMAGE=bizbase/platform:pg-amd64
ARG NATIVE_CRM_IMAGE=bizbase/erpnext-crm:16.55.0-16.0.4
FROM --platform=$BUILDPLATFORM ${NATIVE_CRM_IMAGE} AS crm_assets
WORKDIR /home/frappe/frappe-bench
# Copy only CRM source, browser assets and message catalogs from the verified native build.
RUN set -eu; test "$(git -C apps/crm rev-parse HEAD)" = 9ace234fceb3c5e7bd630b74f44ba1779e831abe; \
    test -s apps/crm/crm/public/frontend/index.html; cmp apps/crm/crm/public/frontend/index.html apps/crm/crm/www/crm.html; \
    mkdir -p /tmp/bizbase/apps/crm; \
    tar -C apps/crm --exclude=__pycache__ --exclude=node_modules -cf /tmp/crm-source.tar crm pyproject.toml README.md LICENSE; \
    tar -xf /tmp/crm-source.tar -C /tmp/bizbase/apps/crm; \
    find assets/locale -name crm.mo -exec cp --parents '{}' /tmp/bizbase/ \;

FROM frappe/erpnext@sha256:fa1e012a931b12721c4c1407fc0d7876a5ab87d7b3d0757d07e57b2a7d5f5963 AS crm
USER frappe
WORKDIR /home/frappe/frappe-bench
COPY --from=crm_assets --chown=frappe:0 /tmp/bizbase/ ./
RUN uv pip install --python env/bin/python -e apps/crm \
    && env/bin/pip check \
    && ln -s /home/frappe/frappe-bench/apps/crm/crm/public assets/crm \
    && printf '%s\n' frappe erpnext crm > sites/apps.txt

FROM ${PLATFORM_IMAGE}
USER frappe
WORKDIR /home/frappe/frappe-bench
COPY deploy/prod/localize_mail_subjects.py deploy/prod/localize_erp_mail.py deploy/prod/localize_erp_templates.py deploy/prod/check_mail_defaults.py /opt/bizbase-mail/
RUN env/bin/python /opt/bizbase-mail/localize_mail_subjects.py \
    && env/bin/python /opt/bizbase-mail/localize_erp_mail.py --image \
    && env/bin/python /opt/bizbase-mail/localize_erp_templates.py
RUN env/bin/python /opt/bizbase/pg_compat.py --check \
    && env/bin/pip check \
    && env/bin/python -c 'import crm, erpnext, frappe, insights; assert (frappe.__version__, erpnext.__version__, crm.__version__, insights.__version__) == ("16.56.0", "16.55.0", "16.0.4", "3.50.1")' \
    && LC_ALL=C ls -1 apps | diff - sites/apps.txt \
    && printf '%s\n' crm customer_board erpnext file_share frappe insights management_board ops_board sales_board yishan_id | diff - sites/apps.txt \
    && test -f assets/frappe/dist/js/desk.bundle.*.js \
    && test -f assets/erpnext/dist/js/erpnext.bundle.*.js \
    && test -f assets/file_share/icon.svg
