# Example edge vhost for ONE HTTPS alias. Replace report.channel.example and the
# certificate paths. bizbase_slot is already declared by the main BizBase vhost.
# Do not install this as a default_server or point directly at a blue/green port.
server {
    listen 80;
    server_name report.channel.example;
    if ($host != $server_name) { return 404; }
    access_log off;
    return 308 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name report.channel.example;
    ssl_certificate     /etc/nginx/certs/report.channel.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/report.channel.example/privkey.pem;
    if ($host != $server_name) { return 404; }
    if ($ssl_server_name != $server_name) { return 404; }
    # Reports can contain signed resource paths. Don't copy those into edge logs.
    access_log off;
    client_max_body_size 50m;

    # Channel aliases expose only public/password reporting (not ERP/Desk or API).
    # Staff-only entries require a trusted company login domain; see OPERATIONS.md.
    # Always proxy assets to the renderer; never cache them or serve files directly.
    location ~ "^/(?:file-share/(?:s/)?[A-Za-z0-9]{10}|s/[A-Za-z0-9]{10})(?:/|$)" {
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Frappe-Site-Name "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_redirect off;
        proxy_pass http://bizbase_slot;
    }
    location / { return 404; }
}
