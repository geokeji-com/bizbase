   "fieldtype": "Table",
   "label": "Versions",
   "options": "Static Share Version",
   "read_only": 1
  },
  {
   "fieldname": "section_access",
   "fieldtype": "Section Break",
   "label": "Who Can View"
  },
  {
   "default": "Internal",
   "description": "公司内部：登录的员工可看。指定人员：只有下方列出的人或角色可看。凭密码访问：任何人输入密码后可看。公开：任何拿到链接的人可看。",
   "fieldname": "access_level",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Access Level",
   "options": "Internal\nSpecified\nPassword\nPublic",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.access_level=='Password'",
   "description": "至少 6 位。修改密码后，已输入旧密码的访客需要重新输入。",
   "fieldname": "password",
   "fieldtype": "Password",
   "label": "Access Password",
   "mandatory_depends_on": "eval:doc.access_level=='Password'"
  },
  {
   "fieldname": "column_break_access",
   "fieldtype": "Column Break"
  },
  {
