  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "section_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "description": "上传单个 HTML，或包含 index.html 的 ZIP（图片、CSS、JS 放在同一个压缩包里）。重新上传会生成新版本，链接不变。",
   "fieldname": "upload",
   "fieldtype": "Attach",
   "label": "Upload",
   "reqd": 1
  },
  {
   "description": "查看者看到的版本。改成旧版本号即可回退。",
