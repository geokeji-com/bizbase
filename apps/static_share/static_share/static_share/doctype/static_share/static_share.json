   "fieldtype": "Table MultiSelect",
   "label": "Allowed Users",
   "options": "Static Share User"
  },
  {
   "depends_on": "eval:doc.access_level=='Specified'",
   "description": "拥有任一所列角色的员工可看。",
   "fieldname": "allowed_roles",
   "fieldtype": "Table MultiSelect",
   "label": "Allowed Roles",
   "options": "Static Share Role"
